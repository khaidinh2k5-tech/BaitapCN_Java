    private void btnHienThiActionPerformed(java.awt.event.ActionEvent evt) {                                           
        // TODO add your handling code here:
        try {
            int n = Integer.parseInt(txtN.getText().trim());
            
            if (n <= 0) {
                JOptionPane.showMessageDialog(this, "Vui lòng nhập n là một số nguyên dương!", "Lỗi", JOptionPane.ERROR_MESSAGE);
                return;
            }
            
            StringBuilder sb = new StringBuilder();
            long f1 = 0, f2 = 1;
            
            for (int i = 0; i < n; i ++) {
                sb.append(f1).append(", ");
                long next = f1 + f2;
                f1 = f2;
                f2 = next;
            }
            
            String ketQua = sb.toString();
            if (ketQua.endsWith(", ")) {
                ketQua = ketQua.substring(0, ketQua.length() - 2);
            }
            txtAreaKetQua.setText(ketQua);
            
        } catch (NumberFormatException ex) {
            JOptionPane.showMessageDialog(this, "Lỗi: Bạn phải nhập một số nguyên!", "Lỗi Nhập Liệu", JOptionPane.ERROR_MESSAGE);
            txtAreaKetQua.setText("");
        }
    }                                          

