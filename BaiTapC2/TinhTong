    private void bntTinhTongActionPerformed(java.awt.event.ActionEvent evt) {                                            
        // TODO add your handling code here:
        try {
        // Lấy chuỗi từ Text Field và chuyển sang số thực
        double so1 = Double.parseDouble(txtSo1.getText());
        double so2 = Double.parseDouble(txtSo2.getText());
        
        // Tính toán
        double tong = so1 + so2;
        
        // In ra màn hình (chuyển số về lại chuỗi)
        txtKetQua.setText(String.valueOf(tong));
        
    } catch (NumberFormatException e) {
        // Hộp thoại báo lỗi xuất hiện nếu nhập không phải số
        JOptionPane.showMessageDialog(this, "Lỗi: Dữ liệu nhập vào phải là số hợp lệ!", "Lỗi", JOptionPane.ERROR_MESSAGE);
    }
    }                                           

