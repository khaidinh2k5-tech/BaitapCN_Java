    private void tinhToan(String phepToan) {
        try {
            double so1 = Double.parseDouble(txtSo1.getText().trim());
            double so2 = Double.parseDouble(txtSo2.getText().trim());
            double ketQua = 0;

            // Xử lý từng phép toán
            switch (phepToan) {
                case "+":
                    ketQua = so1 + so2;
                    break;
                case "-":
                    ketQua = so1 - so2;
                    break;
                case "*":
                    ketQua = so1 * so2;
                    break;
                case "/":
                    // XỬ LÝ LỖI CHIA CHO 0
                    if (so2 == 0) {
                        JOptionPane.showMessageDialog(this, "Không thể chia một số cho 0!", "Lỗi Toán Học", JOptionPane.ERROR_MESSAGE);
                        txtKetQua.setText("Lỗi chia 0!");
                        return; // Thoát hàm ngay lập tức, không ghi vào lịch sử
                    }
                    ketQua = so1 / so2;
                    break;
            }

            // Hiển thị kết quả (làm tròn để tránh số thập phân quá dài nếu muốn)
            txtKetQua.setText(String.valueOf(ketQua));

            // Ghi vào lịch sử sử dụng hàm append() (nối chuỗi vào đuôi)
            String dongLichSu = so1 + " " + phepToan + " " + so2 + " = " + ketQua + "\n";
            txtLichSu.append(dongLichSu);

        } catch (NumberFormatException ex) {
            JOptionPane.showMessageDialog(this, "Vui lòng nhập số hợp lệ!", "Lỗi Nhập Liệu", JOptionPane.ERROR_MESSAGE);
            txtKetQua.setText("Lỗi!");
        }
    }
    private void btnTruActionPerformed(java.awt.event.ActionEvent evt) {                                       
        // TODO add your handling code here:
        tinhToan("-");
