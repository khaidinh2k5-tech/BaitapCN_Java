    private void btnKiemTraActionPerformed(java.awt.event.ActionEvent evt) {                                           
        // TODO add your handling code here:
        try {
            double a = Double.parseDouble(txtA.getText().trim());
            double b = Double.parseDouble(txtB.getText().trim());
            double c = Double.parseDouble(txtC.getText().trim());
            
            if (a <= 0 || b <= 0 || c <= 0 || (a + b <= c) || (a + c <= b) || (b + c <= a)) {
                txtKetQua.setText("Không phải là tam giác hợp lệ!");
            } else {
                boolean isVuong = (a * a + b * b == c * c) || (a * a + c * c == b * b) || (b * b + c * c == a * a);
                boolean isDeu = (a==b) && (b==c);
                boolean isCan = (a==b) && (a==c) && (b==c);
                
                if (isDeu) {
                    txtKetQua.setText("Tam giác đều");
                } else if (isVuong && isCan) {
                    txtKetQua.setText("Tam giác vuông cân");
                } else if (isVuong) {
                    txtKetQua.setText("Tam giác vuông");
                } else if (isCan) {
                    txtKetQua.setText("Tam giác cân");
                } else {
                    txtKetQua.setText("Tam giác thường");
                }
            }
        } catch (NumberFormatException ex) {
            JOptionPane.showMessageDialog(this,
                    "Vui lòng nhập số hợp lệ cho các cạnh",
                    "Lỗi nhập liệu",
                    JOptionPane.ERROR_MESSAGE);
            txtKetQua.setText("Lỗi nhập liệu");
            
        }
    }                                          

