package vn.edu.eaut.lab4;

import javax.swing.*;
import java.awt.*;

public class PrimeSumFrame extends JFrame {
    
    // Khai báo các thành phần giao diện
    private JTextField txtN;
    private JButton btnCalculate;
    private JLabel lblResult;
    private JProgressBar progressBar;

    public PrimeSumFrame() {
        // Thiết lập cấu hình cửa sổ
        setTitle("Bài 3 - Tổng các số nguyên tố");
        setSize(450, 200);
        setDefaultCloseOperation(JFrame.EXIT_ON_CLOSE);
        setLocationRelativeTo(null); // Căn giữa màn hình

        // Khởi tạo các thành phần
        txtN = new JTextField(15);
        btnCalculate = new JButton("Tính");
        
        progressBar = new JProgressBar(0, 100);
        progressBar.setStringPainted(true); // Hiển thị % trên thanh
        
        lblResult = new JLabel("Kết quả: ");
        lblResult.setFont(new Font("Arial", Font.BOLD, 14));

        // Thiết lập bố cục (Layout)
        setLayout(new FlowLayout(FlowLayout.CENTER, 10, 15));
        
        add(new JLabel("Nhập số nguyên N:"));
        add(txtN);
        add(btnCalculate);
        
        progressBar.setPreferredSize(new Dimension(400, 25));
        add(progressBar);
        add(lblResult);

        // Gắn sự kiện cho nút bấm
        btnCalculate.addActionListener(e -> calculatePrimeSum());
    }

    // Hàm kiểm tra số nguyên tố được tối ưu
    private boolean isPrime(int n) {
        if (n < 2) return false;
        if (n == 2) return true;
        if (n % 2 == 0) return false;
        for (int i = 3; i <= Math.sqrt(n); i += 2) {
            if (n % i == 0) return false;
        }
        return true;
    }

    // Hàm xử lý SwingWorker
    private void calculatePrimeSum() {
        int n;
        try {
            n = Integer.parseInt(txtN.getText().trim());
            if (n <= 2) {
                JOptionPane.showMessageDialog(this, "N phải lớn hơn 2");
                return;
            }
        } catch (NumberFormatException ex) {
            JOptionPane.showMessageDialog(this, "Vui lòng nhập số nguyên hợp lệ");
            return;
        }
        
        btnCalculate.setEnabled(false);
        progressBar.setValue(0);
        lblResult.setText("Đang tính...");
        
        SwingWorker<Long, Void> worker = new SwingWorker<>() {
            @Override
            protected Long doInBackground() {
                long sum = 0;
                // Đã xóa dòng chữ rác của tài liệu tại đây
                for (int i = 2; i < n; i++) {
                    if (isPrime(i)) sum += i;
                    
                    // Cập nhật tiến độ
                    int progress = (int) ((i * 100.0) / n);
                    setProgress(progress);
                }
                return sum;
            }
            
            @Override
            protected void done() {
                try {
                    long result = get();
                    lblResult.setText("Tổng các số nguyên tố nhỏ hơn " + n + " = " + result);
                } catch (Exception ex) {
                    lblResult.setText("Có lỗi khi tính toán");
                }
                btnCalculate.setEnabled(true);
                progressBar.setValue(100);
            }
        };
        
        // Lắng nghe thay đổi tiến độ để cập nhật ProgressBar
        worker.addPropertyChangeListener(evt -> {
            if ("progress".equals(evt.getPropertyName())) {
                progressBar.setValue((int) evt.getNewValue());
            }
        });
        
        worker.execute();
    }

    // Hàm main để chạy thử
    public static void main(String[] args) {
        SwingUtilities.invokeLater(() -> {
            new PrimeSumFrame().setVisible(true);
        });
    }
}
