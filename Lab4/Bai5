package vn.edu.eaut.lab4;

import javax.swing.*;
import java.awt.*;
import java.io.BufferedReader;
import java.io.File;
import java.nio.charset.StandardCharsets;
import java.nio.file.Files;

public class LineCounterFrame extends JFrame {

    // Khai báo các thành phần giao diện
    private JButton btnChooseFile;
    private JButton btnCount;
    private JLabel lblFile;
    private JLabel lblResult;
    private JProgressBar progressBar;
    private File selectedFile;

    public LineCounterFrame() {
        // 1. Thiết lập cấu hình cửa sổ
        setTitle("Bài 5 - Đọc file lớn và đếm số dòng");
        setSize(500, 250);
        setDefaultCloseOperation(JFrame.EXIT_ON_CLOSE);
        setLocationRelativeTo(null); // Căn giữa màn hình

        // 2. Khởi tạo các thành phần
        btnChooseFile = new JButton("Chọn file");
        btnCount = new JButton("Đếm dòng");
        lblFile = new JLabel("File: Chưa chọn");
        lblResult = new JLabel("Số dòng: 0");
        lblResult.setFont(new Font("Arial", Font.BOLD, 14));

        progressBar = new JProgressBar(0, 100);
        progressBar.setStringPainted(true); // Hiển thị phần trăm
        
        // 3. Bố trí giao diện (Sử dụng BoxLayout xếp dọc)
        JPanel mainPanel = new JPanel();
        mainPanel.setLayout(new BoxLayout(mainPanel, BoxLayout.Y_AXIS));
        mainPanel.setBorder(BorderFactory.createEmptyBorder(15, 15, 15, 15));

        // Dòng 1: Chọn file và hiển thị tên file
        JPanel pnlTop = new JPanel(new FlowLayout(FlowLayout.LEFT));
        pnlTop.add(btnChooseFile);
        pnlTop.add(lblFile);

        // Dòng 2: Nút đếm dòng và thanh tiến trình
        JPanel pnlMid = new JPanel(new FlowLayout(FlowLayout.LEFT));
        pnlMid.add(btnCount);
        progressBar.setPreferredSize(new Dimension(300, 25)); // Đặt kích thước thanh progress
        pnlMid.add(progressBar);

        // Dòng 3: Kết quả
        JPanel pnlBottom = new JPanel(new FlowLayout(FlowLayout.LEFT));
        pnlBottom.add(lblResult);

        mainPanel.add(pnlTop);
        mainPanel.add(pnlMid);
        mainPanel.add(pnlBottom);
        add(mainPanel);

        // 4. Gắn sự kiện cho các nút
        btnChooseFile.addActionListener(e -> chooseFile());
        btnCount.addActionListener(e -> countLines());
    }

    // Hàm mở hộp thoại chọn file
    private void chooseFile() {
        JFileChooser chooser = new JFileChooser();
        int result = chooser.showOpenDialog(this);
        if (result == JFileChooser.APPROVE_OPTION) {
            selectedFile = chooser.getSelectedFile();
            lblFile.setText("File: " + selectedFile.getAbsolutePath());
        }
    }

    // Hàm đếm số dòng bằng SwingWorker
    private void countLines() {
        if (selectedFile == null) {
            JOptionPane.showMessageDialog(this, "Vui lòng chọn file trước");
            return;
        }
        
        btnCount.setEnabled(false);
        progressBar.setValue(0);
        lblResult.setText("Đang đọc file...");
        
        SwingWorker<Long, Void> worker = new SwingWorker<>() {
            @Override
            protected Long doInBackground() throws Exception {
                long totalBytes = Files.size(selectedFile.toPath());
                long readBytes = 0;
                long lines = 0;
                
                try (BufferedReader reader = Files.newBufferedReader(
                        selectedFile.toPath(), StandardCharsets.UTF_8)) {
                    String line;
                    while ((line = reader.readLine()) != null) {
                        lines++;
                        readBytes += line.getBytes(StandardCharsets.UTF_8).length + 1;
                        
                        // Tính toán % tiến độ
                        int progress = totalBytes == 0 ? 100 : (int) Math.min(100, (readBytes * 100 / totalBytes));
                        setProgress(progress);
                    }
                }
                return lines;
            }
            
            @Override
            protected void done() {
                try {
                    long lineCount = get();
                    lblResult.setText("Số dòng: " + lineCount);
                } catch (Exception ex) {
                    lblResult.setText("Lỗi khi đọc file");
                }
                progressBar.setValue(100);
                btnCount.setEnabled(true);
            }
        };
        
        // Cập nhật giao diện thanh Progress Bar
        worker.addPropertyChangeListener(evt -> {
            if ("progress".equals(evt.getPropertyName())) {
                progressBar.setValue((int) evt.getNewValue());
            }
        });
        
        worker.execute();
    }

    // Hàm main để chạy thử chương trình
    public static void main(String[] args) {
        SwingUtilities.invokeLater(() -> {
            new LineCounterFrame().setVisible(true);
        });
    }
}
